{% extends "base.html.j2" %}
{% block header %}
  <title>Leader - Lead Generation Tooling</title>
{% endblock %}
{% block body %}
  <article class="container">
    <h1>Your projects</h1>
    <div class="card-list">
      {% for project in projects %}
        <a href="/projects/{{ project.id }}">
          <article class="card">
            <header>
              <div>{{ project.name }}</div>
            </header>
          </article>
        </a>
      {% endfor %}
    </div>
    <a href="/projects/create">
      <button>Create a new project</button>
    </a>
  </div>
{% endblock %}
