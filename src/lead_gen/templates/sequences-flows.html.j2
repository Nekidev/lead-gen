{% extends "base.html.j2" %}
{% block header %}
  <title>Check lead flows for {{ sequence.name }} / Leader</title>
{% endblock header %}
{% block body %}
  <div class="container">
    <div class="breadcrumbs">
      <a href="/">Home</a>
      <a href="/projects/{{ project.id }}">{{ project.name }}</a>
      <a href="/projects/{{ project.id }}/sequences/{{ sequence.id }}">{{ sequence.name }}</a>
    </div>
    <div class="button-row">
      <a href="/projects/{{ project.id }}/sequences/{{ sequence.id }}">
        <button>Edit</button>
      </a>
      <a href="/projects/{{ project.id }}/sequences/{{ sequence.id }}/queue">
        <button>Email Queue</button>
      </a>
      <button disabled>Lead Flows</button>
    </div>
    <h1>Lead Flows</h1>
    {% for lead in leads %}
      <a href="/projects/{{ project.id }}/sequences/{{ sequence.id }}/flows/{{ lead.id }}">
        <article class="card">
          <header>
            <div>{{ lead.person_name }}, {{ lead.person_role }} at {{ lead.company_name }}</div>
            <div class="text-secondary">
              {{ lead.emails|selectattr('kind', 'equalto', 'outgoing')|selectattr("is_sent")|list|length }} emails sent
              &middot;
              {{ lead.emails|selectattr('kind', 'equalto', 'incoming')|list|length }} emails received
              &middot;
              {{ lead.emails|selectattr('kind', 'equalto', 'outgoing')|selectattr("is_sent", "equalto", False)|list|length }} emails scheduled
            </div>
          </header>
        </article>
      </a>
    {% endfor %}
  </div>
{% endblock body %}
