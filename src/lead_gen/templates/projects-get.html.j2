{% extends "base.html.j2" %}
{% block header %}
  <title>Edit {{ project.name }} / Leader</title>
{% endblock header %}
{% block body %}
  <div class="container">
    <div class="breadcrumbs">
      <a href="/">Home</a>
    </div>
    <h1>Project</h1>
    <form method="post" class="container">
      <input
        type="text"
        name="name"
        placeholder="Project name"
        value="{{ project.name|forceescape }}"
      />
      <button type="submit" name="action" value="save">Update project</button>
      <button type="submit" name="action" value="delete">DELETE PROJECT</button>
    </form>
    <h2>Sequences</h2>
    <div class="card-list">
      {% for sequence in project.sequences %}
        <a href="/projects/{{ project.id }}/sequences/{{ sequence.id }}">
          <article class="card">
            <header>
              <div>{{ sequence.name }}</div>
            </header>
          </article>
        </a>
      {% endfor %}
    </div>
    <a href="/projects/{{ project.id }}/sequences/create">
      <button>Create a sequence</button>
    </a>
    <h2>Leads</h2>
    <form class="inline-input" action="/projects/{{ project.id }}/leads/import" method="post">
      <input type="password" placeholder="Hunter API Key" name="hunter-api-key" required />
      <button>Import leads from Hunter</button>
    </form>
    <a href="/projects/{{ project.id }}/leads/create">
      <button>Create a lead</button>
    </a>
    <a href="/projects/{{ project.id }}/flags">
      <button>Edit custom flags</button>
    </a>
    <form action="/projects/{{ project.id }}/leads" method="post" id="flags-form" class="hidden">
    </form>
    <div class="container">
      <div class="table-container">
        <table>
          <thead>
            <tr>
              <th>#</th>
              <th>Name</th>
              <th>Role</th>
              <th>Company</th>
              {% for flag in project.flags %}
                <th>{{ flag.name }}</th>
              {% endfor %}
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            {% for lead in project.leads %}
              <tr>
                <td>{{ loop.index }}.</td>
                <td>
                  <a
                    href="mailto:{{ lead.person_email }}"
                    target="_blank"
                  >{{ lead.person_name }}</a>
                </td>
                <td>{{ lead.person_role }}</td>
                <td>
                  <a
                    href="https://{{ lead.company_website }}"
                    target="_blank"
                  >{{ lead.company_name }}</a>
                </td>
                {% for flag in project.flags %}
                  {% set values = lead.flags|selectattr("flag_id", "equalto", flag.id)|list %}
                  {% if values|length > 0 %}
                    {% set value = (values|first).value %}
                  {% else %}
                    {% set value = "" %}
                  {% endif %}
                  <td class="input">
                    <input
                      type="text"
                      name="flag-{{ lead.id }}-{{ flag.id }}"
                      value="{{ value|forceescape }}"
                      placeholder="{{ flag.default|forceescape }}"
                      form="flags-form"
                    />
                  </td>
                {% endfor %}
                <td>
                  <div class="actions">
                    <a href="/projects/{{ project.id }}/leads/{{ lead.id }}">
                      <button>Edit</button>
                    </a>
                    <form action="/projects/{{ project.id }}/leads/{{ lead.id }}" method="post">
                      <button name="action" value="delete">Delete</button>
                    </form>
                  </div>
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
      <button type="submit" form="flags-form">Save lead flag values</button>
    </div>
  </div>
{% endblock body %}
