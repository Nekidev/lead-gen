{% extends "base.html.j2" %}
{% block header %}
  <title>Create a new sequence for {{ project.name }} / Leader</title>
{% endblock header %}
{% block body %}
  <div class="container">
    <div class="breadcrumbs">
      <a href="/">Home</a>
      <a href="/projects/{{ project.id }}">{{ project.name }}</a>
    </div>
    <h1>Create a Sequence</h1>
    <form action="" method="post" class="container">
      <input type="text" placeholder="Sequence name" required name="name" />
      <button type="submit">Create sequence</button>
    </form>
  </div>
{% endblock body %}
