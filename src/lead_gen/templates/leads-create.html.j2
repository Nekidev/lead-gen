{% extends "base.html.j2" %}
{% block header %}
  <title>Create a lead for {{ project.name }} / Leader</title>
{% endblock header %}
{% block body %}
  <div class="container">
    <div class="breadcrumbs">
      <a href="/">Home</a>
      <a href="/projects/{{ project.id }}">{{ project.name }}</a>
    </div>
    <h1>Create a Lead</h1>
    <form action="/projects/{{ project.id }}/leads/create" method="post" class="container">
      <div class="divider">Person</div>
      <input type="text" placeholder="Person name" name="person-name" />
      <input type="email" placeholder="Person email" name="person-email" />
      <input type="text" placeholder="Person role" name="person-role" />
      <div class="gap"></div>
      <div class="divider">Company</div>
      <input type="text" placeholder="Company name" name="company-name">
      <input type="text" placeholder="Company website, e.g. google.com" name="company-website">
      <div class="gap"></div>
      <div class="divider">Flags</div>
      {% for flag in project.flags %}
        <input type="text" name="flag-{{ flag.id }}" placeholder="{{ flag.name }} {% if flag.default %}(default: {{ flag.default }}){% endif %}">
      {% endfor %}
      <button>Create lead</button>
    </form>
  </div>
{% endblock body %}
