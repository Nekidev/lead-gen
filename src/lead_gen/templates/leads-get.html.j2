{% extends "base.html.j2" %}
{% block header %}
  <title>Update lead {{ lead.name }} for {{ project.name }} / Leader</title>
{% endblock header %}
{% block body %}
  <div class="container">
    <div class="breadcrumbs">
      <a href="/">Home</a>
      <a href="/projects/{{ project.id }}">{{ project.name }}</a>
    </div>
    <h1>{{ lead.person_name }}</h1>
    <form action="/projects/{{ project.id }}/leads/{{ lead.id }}" method="post" class="container">
      <div class="divider">Person</div>
      <input
        type="text"
        placeholder="Person name"
        name="person-name"
        value="{{ lead.person_name|forceescape }}"
      />
      <input
        type="email"
        placeholder="Person email"
        name="person-email"
        value="{{ lead.person_email|forceescape }}"
      />
      {% if lead.person_email %}
        <a
          href="mailto:{{ lead.person_email|forceescape }}"
          class="text-xs"
          target="_blank"
          style="margin: -0.5rem 0;"
        >Email them in a new tab</a>
      {% endif %}
      <input
        type="text"
        placeholder="Person role"
        name="person-role"
        value="{{ lead.person_role|forceescape }}"
      />
      <div class="gap"></div>
      <div class="divider">Company</div>
      <input
        type="text"
        placeholder="Company name"
        name="company-name"
        value="{{ lead.company_name|forceescape }}"
      />
      <input
        type="text"
        placeholder="Company website, e.g. google.com"
        name="company-website"
        value="{{ lead.company_website|forceescape }}"
      />
      {% if lead.company_website %}
        <a
          href="https://{{ lead.company_website|forceescape }}"
          class="text-xs"
          target="_blank"
          style="margin: -0.5rem 0;"
        >Open website in new tab</a>
      {% endif %}
      <div class="gap"></div>
      <div class="divider">Flags</div>
      {% for flag in project.flags %}
        {% set values = lead.flags|selectattr("flag_id", "equalto", flag.id)|list %}
        {% if values|length > 0 %}
          {% set value = (values|first).value %}
        {% else %}
          {% set value = "" %}
        {% endif %}
        <input
          type="text"
          name="flag-{{ flag.id }}"
          placeholder="{{ flag.name }} {% if flag.default %}(default: {{ flag.default }}){% endif %}"
          value="{{ value|forceescape }}"
        />
      {% endfor %}
      <button name="action" value="save">Save lead</button>
      <button name="action" value="delete">DELETE LEAD</button>
      <div class="button-row">
        {% if prev %}
          <a href="/projects/{{ project.id }}/leads/{{ prev.id }}">
            <button type="button">Go to previous lead</button>
          </a>
        {% else %}
          <button disabled>Go to previous lead</button>
        {% endif %}
        {% if next %}
          <a href="/projects/{{ project.id }}/leads/{{ next.id }}">
            <button type="button">Go to next lead</button>
          </a>
        {% else %}
          <button disabled>Go to next lead</button>
        {% endif %}
      </div>
    </form>
  </div>
{% endblock body %}
