{% extends "base.html.j2" %}
{% block header %}
  <title>{{ sequence.name }} sequence / Leader</title>
{% endblock header %}
{% block body %}
  <form method="post" id="update-meta">
  </form>
  <form method="post" id="update-schedule">
  </form>
  <form method="post" id="update-sending">
  </form>
  <div class="container">
    <div class="breadcrumbs">
      <a href="/">Home</a>
      <a href="/projects/{{ project.id }}">{{ project.name }}</a>
    </div>
    <div class="button-row">
      <button disabled="disabled">Edit</button>
      <a href="/projects/{{ project.id }}/sequences/{{ sequence.id }}/queue">
        <button>Email Queue</button>
      </a>
      <a href="/projects/{{ project.id }}/sequences/{{ sequence.id }}/flows">
        <button>Lead Flows</button>
      </a>
    </div>
    {% if sequence.is_enabled %}
      <div class="card">
        Your sequence is enabled. This means emails are currently scheduled to be sent and we're
        waiting for replies from prospects. Due to that, most of the sequence cannot be edited. To
        make changes, pause the sequence first.
      </div>
    {% endif %}
    <h1>{{ sequence.name }}</h1>
    <div class="container">
      <input
        type="text"
        value="{{ sequence.name|forceescape }}"
        placeholder="Sequence name"
        name="name"
        form="update-meta"
        required
      />
      <button name="action" value="save" form="update-meta">Update sequence</button>
      <button name="action" value="delete" form="update-meta">DELETE SEQUENCE</button>
    </div>
    <h2>Steps</h2>
    <div class="card-list">
      {% for step in sequence.steps|sort(attribute="index") %}
        <div class="card-with-actions">
          <a href="/projects/{{ project.id }}/sequences/{{ sequence.id }}/steps/{{ step.id }}">
            <article class="card">
              <header>
                <div>
                  <span>{{ loop.index }}. {{ step.name }}</span>
                  <span style="float:right;">Sent after {{ step.days }} days</span>
                </div>
              </header>
            </article>
          </a>
          <form
            class="actions"
            action="/projects/{{ project.id }}/sequences/{{ sequence.id }}/steps/{{ step.id }}"
            method="post"
          >
            <button
              name="action"
              value="delete"
              {% if sequence.is_enabled %}
                disabled
              {% endif %}
            >X</button>
            <button
              name="action"
              value="move-up"
              {% if sequence.is_enabled %}
                disabled
              {% endif %}
            >↑</button>
            <button
              name="action"
              value="move-down"
              {% if sequence.is_enabled %}
                disabled
              {% endif %}
            >↓</button>
          </form>
        </div>
      {% endfor %}
    </div>
    <a href="/projects/{{ project.id }}/sequences/{{ sequence.id }}/steps/create">
      <button {% if sequence.is_enabled %} disabled {% endif %}>Create step</button>
    </a>
    <h2>Schedule</h2>
    <form method="post" class="container">
      <div class="button-row">
        {% for day in ["mon", "tue", "wed", "thu", "fri", "sat", "sun"] %}
          <form method="post">
            {% if day in sequence.send_days %}
              <button
                name="toggle-sending-day"
                value="{{ day }}"
                class="button-toggle on"
                {% if sequence.is_enabled %}
                  type="button"
                {% endif %}
              >{{ day|title }}</button>
            {% else %}
              <button
                name="toggle-sending-day"
                value="{{ day }}"
                class="button-toggle off"
                {% if sequence.is_enabled %}
                  type="button"
                {% endif %}
              >{{ day|title }}</button>
            {% endif %}
          </form>
        {% endfor %}
      </div>
      <div class="inline-input">
        <span>From</span>
        <input
          type="time"
          name="send-time-from"
          form="update-schedule"
          value="{{ sequence.send_time_from.hour|pad('0', 2) }}:{{ sequence.send_time_from.minute|pad('0', 2) }}"
          {% if sequence.is_enabled %}
            disabled
          {% endif %}
        />
        <span>to</span>
        <input
          type="time"
          name="send-time-to"
          form="update-schedule"
          value="{{ sequence.send_time_to.hour|pad('0', 2) }}:{{ sequence.send_time_to.minute|pad('0', 2) }}"
          {% if sequence.is_enabled %}
            disabled
          {% endif %}
        />
      </div>
      <button
        form="update-schedule"
        {% if sequence.is_enabled %}
          disabled
        {% endif %}
      >Save schedule</button>
    </form>
    <h2>Sending</h2>
    <div class="container">
      <div class="inline-input">
        <span>Send up to</span>
        <input
          type="number"
          name="email-daily-max"
          form="update-sending"
          value="{{ sequence.email_daily_max }}"
          {% if sequence.is_enabled %}
            disabled
          {% endif %}
        />
        <span>emails per day</span>
      </div>
      <div class="inline-input">
        <span>Send BCC to</span>
        <input
          type="email"
          name="email-bcc"
          form="update-sending"
          value="{{ (sequence.email_bcc or '')|forceescape }}"
          {% if sequence.is_enabled %}
            disabled
          {% endif %}
        />
      </div>
      <button
        form="update-sending"
        {% if sequence.is_enabled %}
          disabled
        {% endif %}
      >Save email settings</button>
    </div>
    <h2>Email Accounts</h2>
    <div class="container">
      <div class="card-list">
        {% for account in sequence.email_accounts %}
          <div class="card-with-actions">
            <article class="card">
              <header>
                <div>{{ account.name }} &lt;{{ account.email }}&gt;</div>
              </header>
            </article>
            <div class="actions">
              <form method="post" style="display: contents;">
                <button
                  name="remove-account"
                  value="{{ account.id }}"
                  {% if sequence.is_enabled %}
                    disabled
                  {% endif %}
                >X</button>
              </form>
            </div>
          </div>
        {% else %}
          No email accounts in use for this sequence
        {% endfor %}
      </div>
      <form method="post" class="container">
        <div class="inline-input">
          <span>Add an account:</span>
          <select name="add-account" {% if sequence.is_enabled %} disabled {% endif %}>
            {% for account in accounts if account not in sequence.email_accounts %}
              <option
                value="{{ account.id }}"
              >{{ account.name }} &lt;{{ account.email }}&gt;</option>
            {% else %}
              <option disabled>No accounts to add</option>
            {% endfor %}
          </select>
          <button {% if sequence.is_enabled %} disabled {% endif %}>Add and save</button>
        </div>
      </form>
      <a href="/projects/{{ project.id }}/sequences/{{ sequence.id }}/connect/zoho">
        <button>Connect Zoho Mail account</button>
      </a>
    </div>
    {% if sequence.is_enabled %}
      <h2>Sending Status</h2>
      <div class="container">
        <div>This sequence is active and emails are being sent.</div>
        <button name="is-enabled" value="false" form="update-sending">PAUSE SENDING</button>
      </div>
    {% else %}
      <h2>Ready?</h2>
      <div class="container">
        <div>Once a sequence is started, you cannot edit it. To edit it, you'll need to pause it.</div>
        <button name="is-enabled" value="true" form="update-sending">START SEQUENCE!</button>
      </div>
    {% endif %}
  </div>
{% endblock body %}
